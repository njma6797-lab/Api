{
  "version": "2.0",
  "tools": [
    {
      "intent": "open_app",
      "action_type": "LAUNCH_APP",
      "execution": {
        "method": "startActivityByPackage",
        "fallback": "searchPackageByName"
      }
    },
    {
      "intent": "close_app",
      "action_type": "CLOSE_APP",
      "execution": {
        "method": "killBackgroundProcesses",
        "fallback": "goHome"
      }
    },
    {
      "intent": "send_whatsapp_message",
      "action_type": "DEEP_LINK_OR_ACCESSIBILITY",
      "execution": {
        "uri_schema": "https://api.whatsapp.com/send?phone={phone_number}&text={message_text}",
        "fallback_intent": "android.intent.action.SEND"
      }
    },
    {
      "intent": "github_actions",
      "action_type": "GITHUB_API_OR_BROWSER",
      "execution": {
        "bugs_url": "https://github.com/issues?q=is%3Aopen+is%3Aissue+label%3Abug",
        "issues_url": "https://github.com/issues",
        "pull_requests_url": "https://github.com/pulls"
      }
    },
    {
      "intent": "create_website",
      "action_type": "SYSTEM_BUILDER",
      "execution": {
        "handler": "generateWebTemplate"
      }
    },
    {
      "intent": "create_file",
      "action_type": "FILE_IO",
      "execution": {
        "handler": "writeLocalFile"
      }
    },
    {
      "intent": "search_web",
      "action_type": "SEARCH_ENGINE",
      "execution": {
        "url_template": "https://www.google.com/search?q={query}"
      }
    }
  ]
}
